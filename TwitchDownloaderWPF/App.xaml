<Application x:Class="TwitchDownloaderWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TwitchDownloaderWPF"
             xmlns:behave="clr-namespace:TwitchDownloaderWPF.Behaviors"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
                <!-- Top dictionaries MUST be HandyControl, other merged dictionaries below -->
                <ResourceDictionary Source="pack://application:,,,/WpfExtensions.Xaml;component/converters/importoperators.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackground" Color="#F7F7F8" />
            <SolidColorBrush x:Key="AppElementBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppElementBorder" Color="#DCDCE0" />
            <SolidColorBrush x:Key="AppText" Color="#1F1F23" />
            <SolidColorBrush x:Key="AppTextDisabled" Color="#A1A1AA" />
            <SolidColorBrush x:Key="AppElementInnerBackground" Color="#EFEFF1" />
            <SolidColorBrush x:Key="AppElementInnerBorder" Color="#D3D3D9" />
            <SolidColorBrush x:Key="AppInnerText" Color="#1F1F23" />
            <SolidColorBrush x:Key="AppInnerTextDisabled" Color="#A1A1AA" />
            <SolidColorBrush x:Key="AppHyperlink" Color="#772CE8" />
            <SolidColorBrush x:Key="AppCheckBox" Color="#9147FF" />
            <!-- <SolidColorBrush x:Key="AppRadio" Color="#2388ED" /> DEPRECATED :( -->
            <SolidColorBrush x:Key="AppDivider" Color="#E5E5EA" />
            <SolidColorBrush x:Key="AppDividerText" Color="#53535F" />

            <SolidColorBrush x:Key="BigButtonBackground" Color="#9147FF" />
            <SolidColorBrush x:Key="BigButtonBorder" Color="#9147FF" />
            <SolidColorBrush x:Key="BigButtonText" Color="#FFFFFF" />

            <SolidColorBrush x:Key="ActionButtonBackground" Color="#772CE8" />
            <SolidColorBrush x:Key="ActionButtonBorder" Color="#772CE8" />
            <SolidColorBrush x:Key="ActionButtonText" Color="#FFFFFF" />

            <SolidColorBrush x:Key="StatusBarBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StatusBarBorder" Color="#E5E5EA" />
            <SolidColorBrush x:Key="StatusBarElement" Color="#F2F2F4" />
            <SolidColorBrush x:Key="StatusBarElementBorder" Color="#DCDCE0" />
            <SolidColorBrush x:Key="StatusBarText" Color="#1F1F23" />
            <SolidColorBrush x:Key="ProgressBarForeground" Color="#9147FF" />

            <!-- Rounded corners for common controls -->
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
            </Style>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
            </Style>
            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="hc:BorderElement.CornerRadius" Value="6" />
            </Style>

            <Style TargetType="{x:Type local:MainWindow}">
                <Setter Property="behave:WindowIntegrityCheckBehavior.IntegrityCheck" Value="True"></Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>