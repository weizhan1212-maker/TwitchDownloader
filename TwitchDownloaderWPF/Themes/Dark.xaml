<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--Boolean values MUST be lower-case-->
    <system:Boolean x:Key="DarkTitleBar">true</system:Boolean>
    <system:Boolean x:Key="DarkHandyControl">true</system:Boolean>

    <!--Standard app and app element colors-->
    <SolidColorBrush x:Key="AppBackground" Color="#18181B"/>
    <SolidColorBrush x:Key="AppElementBackground" Color="#1F1F23"/>
    <SolidColorBrush x:Key="AppElementBorder" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="AppText" Color="#EFEFF1"/>
    <SolidColorBrush x:Key="AppTextDisabled" Color="#7A7A85"/>
    <SolidColorBrush x:Key="AppElementInnerBackground" Color="#2F2F35"/>
    <SolidColorBrush x:Key="AppElementInnerBorder" Color="#45454D"/>
    <SolidColorBrush x:Key="AppInnerText" Color="#DEDEE3"/>
    <SolidColorBrush x:Key="AppInnerTextDisabled" Color="#8A8A93"/>
    <SolidColorBrush x:Key="AppHyperlink" Color="#BF94FF"/>
    <SolidColorBrush x:Key="AppCheckBox" Color="#9147FF"/>
    <!-- <SolidColorBrush x:Key="AppRadio" Color="#B5005D"/> DEPRECATED -->
    <SolidColorBrush x:Key="AppDivider" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="AppDividerText" Color="#ADADB8"/>

    <!--Big buttons at the top of the window-->
    <SolidColorBrush x:Key="BigButtonBackground" Color="#9147FF"/>
    <SolidColorBrush x:Key="BigButtonBorder" Color="#9147FF"/>
    <SolidColorBrush x:Key="BigButtonText" Color="#FFFFFF"/>

    <!--Basically every other button-->
    <SolidColorBrush x:Key="ActionButtonBackground" Color="#772CE8"/>
    <SolidColorBrush x:Key="ActionButtonBorder" Color="#772CE8"/>
    <SolidColorBrush x:Key="ActionButtonText" Color="#FFFFFF"/>

    <!--Bottom status bar and progress bar-->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#0E0E10"/>
    <SolidColorBrush x:Key="StatusBarBorder" Color="#26262C"/>
    <SolidColorBrush x:Key="StatusBarElement" Color="#1F1F23"/>
    <SolidColorBrush x:Key="StatusBarElementBorder" Color="#3A3A3D"/>
    <SolidColorBrush x:Key="StatusBarText" Color="#DEDEE3"/>
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#A970FF"/>
</ResourceDictionary>